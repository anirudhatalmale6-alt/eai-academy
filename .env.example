# Copy to .env and fill in from the Academy's own Supabase project.
# Until these are set, the app runs in preview mode (seed data, no live writes).

# Public (safe to expose — shipped in the frontend bundle, protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-side only (NEVER commit real values; set in the host's env) ---
# Used by Phase 2/3 server functions (Stripe, admin reads, emails).
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
NOTIFY_TO=
